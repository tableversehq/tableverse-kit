{
  "name": "@tableverse-kit/client",
  "version": "0.1.0-beta.1",
  "description": "Renderer-agnostic typed client connecting a frontend to a running Tableverse game.",
  "license": "Apache-2.0",
  "homepage": "https://docs.tableverse.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tableversehq/tableverse-kit.git",
    "directory": "packages/client"
  },
  "type": "module",
  "private": false,
  "exports": {
    ".": "./src/index.ts",
    "./dev": "./src/dev/index.ts"
  },
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "dev": [
        "./src/dev/index.ts"
      ]
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tableverse-kit/engine": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
