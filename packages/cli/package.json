{
  "name": "@tableverse-kit/cli",
  "version": "0.1.0-beta.4",
  "description": "The tvk command: validate, preview, and upload Tableverse games.",
  "license": "Apache-2.0",
  "homepage": "https://docs.tableverse.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tableversehq/tableverse-kit.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "private": false,
  "exports": {
    ".": "./src/main.ts"
  },
  "bin": {
    "tvk": "./bin/tvk.js"
  },
  "files": [
    "bin",
    "src",
    "dist/shell"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:shell": "vite build --config shell/vite.config.ts",
    "prepack": "pnpm run build:shell && node scripts/verify-shell-build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@sinclair/typebox": "^0.34.41",
    "@tableverse-kit/config": "workspace:*",
    "@tableverse-kit/engine": "workspace:*",
    "tar": "^7.5.21",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@inquirer/testing": "^3.3.9",
    "@tableverse-kit/client": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.1.12"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
